{
  "rewrites": [
    { "source": "/alert/:id", "destination": "/api/alert-og?id=:id" },
    { "source": "/en/alert/:id", "destination": "/api/alert-og?id=:id&lang=en" },
    { "source": "/ar/alert/:id", "destination": "/api/alert-og?id=:id&lang=ar" },
    { "source": "/ru/alert/:id", "destination": "/api/alert-og?id=:id&lang=ru" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(og\\.png|favicon\\.svg|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
